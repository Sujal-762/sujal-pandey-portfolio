{
  "name": "sujal-pandey-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Sujal Pandey — forensic science portfolio: scene, lab and archive. React + Vite, pre-rendered to static HTML.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "npm run build && node scripts/check.mjs",
    "check:publish": "npm run build && node scripts/check.mjs --strict",
    "set-domain": "node scripts/set-domain.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  }
}
